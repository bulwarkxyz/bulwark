{
  "name": "@bulwarkxyz/store",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bulwarkxyz/guard-core": "workspace:*",
    "@bulwarkxyz/hyperliquid": "workspace:*",
    "@noble/hashes": "^2",
    "postgres": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
