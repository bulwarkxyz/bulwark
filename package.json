{
  "name": "bulwark",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "fixtures:capture": "node scripts/capture-fixtures.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:review-mode": "node scripts/review-mode-check.mjs",
    "check:public": "node scripts/public-repo-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
